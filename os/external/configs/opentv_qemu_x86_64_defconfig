# Open TV OS — QEMU x86_64 (fast dev/CI target, KVM on x86 hosts)
# Same userspace and UI code as the aarch64 target.
BR2_x86_64=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_12=y
BR2_GLOBAL_PATCH_DIR="board/qemu/patches"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_SYSTEM_DHCP="eth0"
BR2_ROOTFS_POST_BUILD_SCRIPT="board/qemu/x86_64/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="board/qemu/post-image.sh"
BR2_ROOTFS_POST_SCRIPT_ARGS="$(BR2_DEFCONFIG)"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.12.47"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_OTV_PATH)/board/opentv/linux-x86_64.config"
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y
BR2_TARGET_ROOTFS_EXT2=y
# BR2_TARGET_ROOTFS_TAR is not set

# ── Open TV OS ──────────────────────────────────────────────────────────
BR2_TARGET_GENERIC_HOSTNAME="opentv"
BR2_TARGET_GENERIC_ISSUE="Open TV OS (placeholder name) — development image"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_OTV_PATH)/board/opentv/overlay"
BR2_PACKAGE_LIBDRM=y
BR2_PACKAGE_OTV_LAUNCHER=y
